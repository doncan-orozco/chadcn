# frozen_string_literal: true

require_relative "lib/chadcn/version"

# The repository location. The metadata URIs and the links of the
# generated llms files derive from them; the README hero image URLs and the CHANGELOG compare link repeat them by hand
# (test/packaging/packaging_test.rb checks those copies).
repository = "https://github.com/doncan-orozco/chadcn"
gem_path = ""
ref = "main"
at = ->(kind, *rest) { [ repository, kind, ref, gem_path, *rest ].reject(&:empty?).join("/") }

Gem::Specification.new do |spec|
  spec.name = "chadcn"
  spec.version = Chadcn::VERSION
  spec.authors = [ "Doncan Orozco" ]
  spec.email = [ "doncan.orozco@gmail.com" ]

  spec.summary = "shadcn/ui for Phlex. chadcn go brrrrrr."
  spec.description = "A 1:1 port of the shadcn/ui component library to Phlex views with Stimulus behavior, " \
                     "Tailwind classes taken verbatim from shadcn/ui and shadcn-format theme variables. " \
                     "Not affiliated with shadcn. Built on shadcn/ui (MIT)."
  spec.homepage = at.call("tree")
  spec.license = "MIT"
  spec.required_ruby_version = ">= 3.3"

  spec.metadata["source_code_uri"] = repository
  spec.metadata["changelog_uri"] = at.call("blob", "CHANGELOG.md")
  spec.metadata["rubygems_mfa_required"] = "true"

  # llms.txt, llms-full.txt and skills/ ship (generated by `rake llms:generate`).
  # docs/ and .yardopts ship because the README links the docs and `yard` reads .yardopts; the dev kit (dev/), tests and the dummy app do not.
  packaged = %w[lib/**/* app/**/* config/**/* vendor/**/* docs/*.md skills/**/* llms.txt llms-full.txt .yardopts LICENSE README.md CHANGELOG.md THIRD_PARTY_NOTICES.md]
  spec.files = Dir[*packaged].select { |f| File.file?(f) }
  spec.require_paths = [ "lib" ]

  spec.add_dependency "phlex", "~> 2.3"
  spec.add_dependency "tailwind_merge", "~> 1.4"
  spec.add_dependency "zeitwerk", "~> 2.7"
end
