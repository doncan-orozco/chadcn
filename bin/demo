#!/usr/bin/env ruby
# frozen_string_literal: true

# Boots the gem's demo (the dummy app's catalog at /) on a free port and prints the URL.
#   bin/demo [--port N]
require "optparse"
require "socket"

$stdout.sync = true

options = {}
OptionParser.new { |o| o.on("--port N", Integer) { |n| options[:port] = n } }.parse!

def port_free?(port)
  %w[127.0.0.1 ::1].all? do |host|
    TCPServer.new(host, port).close
    true
  rescue Errno::EADDRINUSE, Errno::EACCES
    false
  rescue SocketError, Errno::EADDRNOTAVAIL
    true
  end
end

port = options[:port] || (3055..3255).find { |p| port_free?(p) } || abort("no free port near 3055")
dummy = File.expand_path("../dev/dummy", __dir__)
env = { "BUNDLE_GEMFILE" => File.join(dummy, "Gemfile") }

Dir.chdir(dummy) do
  system(env, "bin/rails", "tailwindcss:build") || abort("tailwindcss:build failed")
  puts "chadcn demo: http://127.0.0.1:#{port}/"
  exec(env, "bin/rails", "server", "-p", port.to_s, "-b", "127.0.0.1")
end
