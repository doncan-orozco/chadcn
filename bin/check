#!/usr/bin/env bash
# Runs the gem's tests (plain, Rails engine and the dev dummy's parity harness), RuboCop, the dependency audit and the gem gate; exits non-zero on the first failure.
set -euo pipefail

cd "$(dirname "$0")/.."
export BUNDLE_GEMFILE="$(pwd)/Gemfile"

# It is part of the contract (ruby-gem-conventions R10): a checkout without it fails instead of skipping the parity tests silently.
if [ ! -f dev/dummy/Gemfile ]; then
  echo "bin/check: dev/dummy/Gemfile is missing, so the parity harness tests cannot run. Restore dev (it is not packaged in the gem) or run the plain suites with 'bundle exec rake test test:engine'." >&2
  exit 1
fi

bundle exec rake test
bundle exec rake test:engine
# The benchmark runner is a dev-kit script (not packaged), so rake test does not pick its tests up.
bundle exec ruby dev/bench/runner_test.rb
# The dev kit's parity harness: a DB-less dummy app with its own bundle (Tailwind builds first because the parity page links it).
(
  cd dev/dummy
  export BUNDLE_GEMFILE="$(pwd)/Gemfile"
  bundle install --quiet
  bin/rails tailwindcss:build
  bin/rails test
)
bundle exec rubocop
bundle exec bundler-audit check --update
ruby .claude/scripts/gem/gem_check.rb --gem-dir .
